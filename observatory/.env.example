# Keep this file server-side. Never put credentials in site/ or a public URL.
OBSERVATORY_ADMIN_TOKEN=replace-with-a-random-owner-token
# Optional stable Fernet key; otherwise a protected key is generated beside DB.
# OBSERVATORY_SECRET_KEY=
# Leave unset for the local ./.observatory/state.sqlite3 or Docker /data/state.sqlite3 default.
# This override is for local use; Docker stores state on its persistent /data volume.
# OBSERVATORY_DB=./.observatory/state.sqlite3
ANONYMIZED_TELEMETRY=false
BROWSER_USE_CLOUD_SYNC=false
# Internal transport authentication, not a model-provider API key.
# Match the payment process token. Keep its Solana private key in the other process.
OBSERVATORY_PAYMENT_BROKER_URL=http://127.0.0.1:8062
OBSERVATORY_PAYMENT_BROKER_TOKEN=replace-with-a-different-random-internal-token
# Provider secrets can be entered in operator setup (encrypted at rest) instead.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# BROWSER_USE_API_KEY=
# HF_TOKEN=
