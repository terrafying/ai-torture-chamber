# Copy to observatory/.env.payments, keep server-side and exclude from Git.
# This process alone holds the owner-provided dedicated spending wallet signer.
# Base58-encoded Solana keypair as accepted by the official x402 SVM signer.
X402_SOLANA_PRIVATE_KEY=
OBSERVATORY_PAYMENT_BROKER_TOKEN=replace-with-the-same-internal-token-as-sidecar
# Disabled until the owner supplies signer, limits and independently approved merchant.
X402_ENABLED=false
# Explicit USDC amounts, at most six decimal places. No spending defaults.
X402_MAX_REQUEST_USDC=
X402_DAILY_LIMIT_USDC=
X402_MIN_RESERVE_USDC=
# Comma-separated independently verified merchant recipient addresses.
# Never copy a payTo from a crawled page into this allowlist automatically.
X402_ALLOWED_PAY_TO=
# Exact model capability registry, based on vendor docs and owner review.
# Empty by default: names/categories alone do not establish browser-action support.
# Owner declarations permit a bounded funded compatibility test; they are not proof.
# X402_RESEARCH_MODEL_CAPABILITIES='{"openai/YOUR_MODEL_ID":{"protocols":["responses"],"vision":true,"structured_actions":true,"structured_outputs":true,"tool_calling":false}}'
X402_RESEARCH_MODEL_CAPABILITIES={}
X402_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
X402_BROKER_DB=./observatory-data/payments.sqlite3
# Optional stable Fernet key. Otherwise a protected key is created beside the ledger.
# Back up the ledger and key together; losing the key loses cached response recovery.
# X402_BROKER_SECRET_KEY=
